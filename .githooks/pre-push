#!/usr/bin/env bash
# Fail-closed leak guard (pre-push): the exposure moment. Every pushed commit's author + committer must be
# the pseudonym, and the pushed tree content must be clean. Self-tests against a canary each run. See
# README.md. (github.com has no server-side pre-receive; the CI workflow is the un-bypassable layer.)
set -uo pipefail
DIR="$(git rev-parse --show-toplevel)/.githooks"
[ -f "$DIR/leak-deny.local" ] && export LEAK_DENY="$(cat "$DIR/leak-deny.local")"
GUARD="$DIR/leak-guard.sh"
ZERO='0000000000000000000000000000000000000000'
while read -r _lref loid _rref roid; do
  [ "$loid" = "$ZERO" ] && continue
  if [ "$roid" = "$ZERO" ]; then range="$loid"; else range="$roid..$loid"; fi
  "$GUARD" identity "$range" || exit $?
done
"$GUARD" content tree || exit $?

# ── Data gate: all right or no go ────────────────────────────────────────────────────────────────
# The exposure moment for DATA as well as identity. Invariants must hold and no budget may have
# loosened; check.py self-tests first and refuses to pass anything if its own canaries are not
# caught, on the same fail-closed principle as the leak guard above.
#
# Skipped when there is no build output — a docs-only commit should not require a full build — and
# bypassable with --no-verify, exactly like the guard. CI is the backstop.
ROOT="$(git rev-parse --show-toplevel)"

# A TREE ALREADY PROVED IS NOT PROVED AGAIN. The gate and the tests run here and again by hand a
# minute earlier, about 127 seconds of re-answering. `greentree` records the tree the gate passed
# on and refuses itself if anything moved, if it covers a different set, or if it records a
# different run. It hashes every tracked file, all of data/build and the deployed site data, which
# is an over-approximation on purpose: a token over the wrong set vouches for a stale answer.
#
# YURA_NO_TOKEN=1 forces the full path. CI sets it, so the boundary that matters never trusts a
# token written on somebody's laptop.
if python3 "$ROOT/adapters/greentree.py" --held gate >/dev/null 2>&1; then
  echo "pre-push: gate and tests already passed on this exact tree; not repeating them."
else
  # TOGETHER, because the gate reads data/build and the tests read source and their own fixtures,
  # and neither writes what the other reads. `cycle.py` also stops the pair proving the same thing
  # twice: ./test.py runs check.py --self-test and --gate runs it again, so the tests carry it and
  # the driver fails if that half fails. 82 s serial, 27 s together.
  if [ -f "$ROOT/data/build/series.json" ]; then
    python3 "$ROOT/cycle.py" || {
      echo "pre-push: the cycle said NO GO. Fix, or --no-verify if you know why." >&2
      exit 1
    }
  else
    "$ROOT/test.py" || { echo "pre-push: tests fail. ./test.py to see why." >&2; exit 1; }
  fi
  "$ROOT/test.py" --canary >/dev/null || { echo "pre-push: a suite is vacuous. ./test.py --canary" >&2; exit 1; }
fi
