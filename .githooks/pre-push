#!/usr/bin/env bash
# Fail-closed leak guard (pre-push): the exposure moment. Every pushed commit's author + committer must be
# the pseudonym, and the pushed tree content must be clean. Self-tests against a canary each run. See
# README.md. (github.com has no server-side pre-receive; the CI workflow is the un-bypassable layer.)
set -uo pipefail
DIR="$(git rev-parse --show-toplevel)/.githooks"
[ -f "$DIR/leak-deny.local" ] && export LEAK_DENY="$(cat "$DIR/leak-deny.local")"
GUARD="$DIR/leak-guard.sh"
ZERO='0000000000000000000000000000000000000000'
while read -r _lref loid _rref roid; do
  [ "$loid" = "$ZERO" ] && continue
  if [ "$roid" = "$ZERO" ]; then range="$loid"; else range="$roid..$loid"; fi
  "$GUARD" identity "$range" || exit $?
done
"$GUARD" content tree || exit $?

# ── Data gate: all right or no go ────────────────────────────────────────────────────────────────
# The exposure moment for DATA as well as identity. Invariants must hold and no budget may have
# loosened; check.py self-tests first and refuses to pass anything if its own canaries are not
# caught, on the same fail-closed principle as the leak guard above.
#
# Skipped when there is no build output — a docs-only commit should not require a full build — and
# bypassable with --no-verify, exactly like the guard. CI is the backstop.
ROOT="$(git rev-parse --show-toplevel)"
if [ -f "$ROOT/data/build/series.json" ]; then
  python3 "$ROOT/check.py" --gate --no-tighten || {
    echo "pre-push: data gate said NO GO. Fix, or --no-verify if you know why." >&2
    exit 1
  }
fi
